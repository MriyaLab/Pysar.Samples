<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage x:Class="Pysar.Maui.Sample.Views.ReportViewerPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:Pysar.Maui.Sample.Converters"
             xmlns:pysar="clr-namespace:Pysar.Maui;assembly=Pysar.Maui"
             xmlns:viewModels="clr-namespace:Pysar.Maui.Sample.ViewModels"
             Title="Pysar Sample"
             x:DataType="viewModels:ReportViewerViewModel"
             Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <converters:IsNotEmptyConverter x:Key="IsNotEmpty" />

        <Style x:Key="ToolbarPill" TargetType="Border">
            <Setter Property="BackgroundColor" Value="#2F2F2F" />
            <Setter Property="Stroke" Value="#4A4A4A" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="StrokeShape" Value="RoundRectangle 24" />
            <Setter Property="HeightRequest" Value="48" />
            <Setter Property="MinimumWidthRequest" Value="48" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="VerticalOptions" Value="Center" />
        </Style>

        <Style x:Key="ToolbarPillButton" TargetType="Button">
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="TextColor" Value="#E8E8E8" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontFamily" Value="OpenSansRegular" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="MinimumHeightRequest" Value="1" />
            <Setter Property="MinimumWidthRequest" Value="28" />
            <Setter Property="VerticalOptions" Value="Fill" />
            <Setter Property="BorderWidth" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal" />
                        <VisualState x:Name="Disabled">
                            <VisualState.Setters>
                                <Setter Property="TextColor" Value="#9A9A9A" />
                                <Setter Property="BackgroundColor" Value="Transparent" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
        </Style>

        <Style x:Key="ToolbarPageEntry" TargetType="Entry">
            <Setter Property="BackgroundColor" Value="#1A1A1A" />
            <Setter Property="TextColor" Value="#EEEEEE" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="WidthRequest" Value="36" />
            <Setter Property="HeightRequest" Value="22" />
            <Setter Property="MinimumHeightRequest" Value="22" />
            <Setter Property="MinimumWidthRequest" Value="36" />
            <Setter Property="HorizontalTextAlignment" Value="Center" />
            <Setter Property="VerticalOptions" Value="Center" />
            <Setter Property="Keyboard" Value="Numeric" />
        </Style>
    </ContentPage.Resources>

    <Grid BackgroundColor="#262626"
          RowDefinitions="Auto,Auto,*"
          RowSpacing="0">
        <Grid Padding="12,8"
              BackgroundColor="#1E1E1E"
              ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto,Auto"
              ColumnSpacing="8">
            <Border Style="{StaticResource ToolbarPill}">
                <Button Clicked="OnOpenFlyoutClicked" Style="{StaticResource ToolbarPillButton}">
                    <Button.ImageSource>
                        <FontImageSource FontFamily="FontAwesomeSolid"
                                         Glyph="bars"
                                         Size="14"
                                         Color="#E8E8E8" />
                    </Button.ImageSource>
                </Button>
            </Border>

            <Entry Grid.Column="1"
                   Style="{StaticResource ToolbarPageEntry}"
                   Text="{Binding CurrentPageText}" />

            <Label Grid.Column="2"
                   FontSize="12"
                   Text="{Binding PageCount, StringFormat='/ {0}'}"
                   TextColor="#9A9A9A"
                   VerticalOptions="Center" />

            <Border Grid.Column="4" Style="{StaticResource ToolbarPill}">
                <HorizontalStackLayout Spacing="0">
                    <Button Command="{Binding ZoomOutCommand}"
                            FontSize="18"
                            Style="{StaticResource ToolbarPillButton}"
                            Text="−" />
                    <BoxView BackgroundColor="#555555"
                             HeightRequest="16"
                             VerticalOptions="Center"
                             WidthRequest="1" />
                    <Button Command="{Binding ActualSizeCommand}"
                            Style="{StaticResource ToolbarPillButton}"
                            Text="{Binding ZoomText}"
                            WidthRequest="52" />
                    <BoxView BackgroundColor="#555555"
                             HeightRequest="16"
                             VerticalOptions="Center"
                             WidthRequest="1" />
                    <Button Command="{Binding ZoomInCommand}"
                            FontSize="18"
                            Style="{StaticResource ToolbarPillButton}"
                            Text="+" />
                </HorizontalStackLayout>
            </Border>

            <Border Grid.Column="5" Style="{StaticResource ToolbarPill}">
                <Button Command="{Binding ToggleFitCommand}" Style="{StaticResource ToolbarPillButton}">
                    <Button.ImageSource>
                        <FontImageSource FontAutoScalingEnabled="True"
                                         FontFamily="FontAwesomeSolid"
                                         Glyph="{Binding FitButtonGlyph}"
                                         Size="18" />
                    </Button.ImageSource>
                </Button>
            </Border>

            <Border Grid.Column="6" Style="{StaticResource ToolbarPill}">
                <Button Command="{Binding PrintCommand}" Style="{StaticResource ToolbarPillButton}">
                    <Button.ImageSource>
                        <FontImageSource FontAutoScalingEnabled="True"
                                         FontFamily="FontAwesomeSolid"
                                         Glyph="print"
                                         Size="18" />
                    </Button.ImageSource>
                </Button>
            </Border>

            <Border Grid.Column="7" Style="{StaticResource ToolbarPill}">
                <Button Command="{Binding ExportPdfCommand}" Style="{StaticResource ToolbarPillButton}">
                    <Button.ImageSource>
                        <FontImageSource FontAutoScalingEnabled="True"
                                         FontFamily="FontAwesomeSolid"
                                         Glyph="arrow-up-from-bracket"
                                         Size="18" />
                    </Button.ImageSource>
                </Button>
            </Border>
        </Grid>

        <Label Grid.Row="1"
               IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotEmpty}}"
               Text="{Binding ErrorMessage}"
               TextColor="#C0392B" />

        <pysar:ReportView x:Name="Viewer"
                          Grid.Row="2"
                          BackgroundColor="#292929"
                          CurrentPage="{Binding CurrentPage}"
                          DocumentPadding="16"
                          EffectiveZoom="{Binding EffectiveZoom}"
                          PageBorderColor="#3E4351"
                          PageBorderThickness="2"
                          PageCount="{Binding PageCount, Mode=OneWayToSource}"
                          PageSpacing="16"
                          RenderBudget="256"
                          RenderFailed="OnRenderFailed"
                          Report="{Binding Report}"
                          Zoom="{Binding Zoom}"
                          ZoomMode="{Binding ZoomMode}" />
    </Grid>
</ContentPage>
