<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!--  Note: For Android please see also Platforms\Android\Resources\values\colors.xml  -->
    <Color x:Key="Primary">#FFFFFF</Color>
    <Color x:Key="PrimaryDark">#ac99ea</Color>
    <Color x:Key="PrimaryDarkText">#242424</Color>
    <Color x:Key="Secondary">#EEEEEE</Color>
    <Color x:Key="SecondaryDarkText">#9880e5</Color>
    <Color x:Key="Tertiary">#212121</Color>

    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="Magenta">#D600AA</Color>
    <Color x:Key="MidnightBlue">#190649</Color>
    <Color x:Key="OffBlack">#1f1f1f</Color>

    <Color x:Key="Gray100">#E1E1E1</Color>
    <Color x:Key="Gray200">#C8C8C8</Color>
    <Color x:Key="Gray300">#ACACAC</Color>
    <Color x:Key="Gray400">#919191</Color>
    <Color x:Key="Gray500">#6E6E6E</Color>
    <Color x:Key="Gray600">#404040</Color>
    <Color x:Key="Gray900">#212121</Color>
    <Color x:Key="Gray950">#141414</Color>

    <Color x:Key="ChromeBackground">#1E1E1E</Color>
    <Color x:Key="ChromeSurface">#262626</Color>
    <Color x:Key="ChromeViewer">#292929</Color>
    <Color x:Key="ChromePill">#2F2F2F</Color>
    <Color x:Key="ChromeStroke">#4A4A4A</Color>
    <Color x:Key="ChromeDivider">#555555</Color>
    <Color x:Key="ChromeText">#E8E8E8</Color>
    <Color x:Key="ChromeMuted">#9A9A9A</Color>
    <Color x:Key="ChromeField">#1A1A1A</Color>
    <Color x:Key="ChromeFieldText">#EEEEEE</Color>
    <Color x:Key="ChromePageBorder">#3E4351</Color>
    <Color x:Key="AppMarkBackground">#141414</Color>
    <Color x:Key="AppMarkForeground">#E8E8E8</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}" />
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}" />
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}" />
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}" />
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}" />

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}" />
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}" />
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}" />
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}" />
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}" />
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}" />
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}" />
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}" />
    <SolidColorBrush x:Key="ChromeBackgroundBrush" Color="{StaticResource ChromeBackground}" />
    <SolidColorBrush x:Key="ChromeSurfaceBrush" Color="{StaticResource ChromeSurface}" />
    <SolidColorBrush x:Key="ChromeViewerBrush" Color="{StaticResource ChromeViewer}" />
    <SolidColorBrush x:Key="ChromePillBrush" Color="{StaticResource ChromePill}" />
    <SolidColorBrush x:Key="ChromeStrokeBrush" Color="{StaticResource ChromeStroke}" />
    <SolidColorBrush x:Key="ChromeDividerBrush" Color="{StaticResource ChromeDivider}" />
    <SolidColorBrush x:Key="ChromeTextBrush" Color="{StaticResource ChromeText}" />
    <SolidColorBrush x:Key="ChromeMutedBrush" Color="{StaticResource ChromeMuted}" />
    <SolidColorBrush x:Key="ChromeFieldBrush" Color="{StaticResource ChromeField}" />
    <SolidColorBrush x:Key="ChromeFieldTextBrush" Color="{StaticResource ChromeFieldText}" />
    <SolidColorBrush x:Key="ChromePageBorderBrush" Color="{StaticResource ChromePageBorder}" />
    <SolidColorBrush x:Key="AppMarkBackgroundBrush" Color="{StaticResource AppMarkBackground}" />
    <SolidColorBrush x:Key="AppMarkForegroundBrush" Color="{StaticResource AppMarkForeground}" />
</ResourceDictionary>
