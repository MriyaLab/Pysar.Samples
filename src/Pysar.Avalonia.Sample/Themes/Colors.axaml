<ResourceDictionary xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  The chrome palette of the MAUI sample; see Pysar.Maui.Sample/Resources/Styles/Colors.xaml.  -->
    <Color x:Key="ChromeBackground">#1E1E1E</Color>
    <Color x:Key="ChromeSurface">#262626</Color>
    <Color x:Key="ChromeViewer">#292929</Color>
    <Color x:Key="ChromePill">#2F2F2F</Color>
    <Color x:Key="ChromeStroke">#4A4A4A</Color>
    <Color x:Key="ChromeDivider">#555555</Color>
    <Color x:Key="ChromeText">#E8E8E8</Color>
    <Color x:Key="ChromeMuted">#9A9A9A</Color>
    <Color x:Key="ChromePageBorder">#3E4351</Color>

    <SolidColorBrush x:Key="ChromeBackgroundBrush" Color="{StaticResource ChromeBackground}" />
    <SolidColorBrush x:Key="ChromeSurfaceBrush" Color="{StaticResource ChromeSurface}" />
    <SolidColorBrush x:Key="ChromeViewerBrush" Color="{StaticResource ChromeViewer}" />
    <SolidColorBrush x:Key="ChromePillBrush" Color="{StaticResource ChromePill}" />
    <SolidColorBrush x:Key="ChromeStrokeBrush" Color="{StaticResource ChromeStroke}" />
    <SolidColorBrush x:Key="ChromeDividerBrush" Color="{StaticResource ChromeDivider}" />
    <SolidColorBrush x:Key="ChromeTextBrush" Color="{StaticResource ChromeText}" />
    <SolidColorBrush x:Key="ChromeMutedBrush" Color="{StaticResource ChromeMuted}" />

    <!--  The page indicator floats over the document, so its pill is translucent.  -->
    <SolidColorBrush x:Key="PageIndicatorBackgroundBrush" Color="#B32F2F2F" />
    <SolidColorBrush x:Key="PageIndicatorStrokeBrush" Color="#B34A4A4A" />

    <!--
        Font Awesome ships one family per weight, so the solid face is addressed by its own family
        name. The file itself is linked into the project from Pysar.Sample.Shared/Fonts.
    -->
    <FontFamily x:Key="FontAwesomeSolid">avares://Pysar.Avalonia.Sample/Fonts#Font Awesome 6 Free Solid</FontFamily>
    <FontFamily x:Key="Cookie">avares://Pysar.Avalonia.Sample/Assets/Fonts#Cookie</FontFamily>

</ResourceDictionary>
