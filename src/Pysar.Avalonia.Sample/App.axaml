<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Pysar.Avalonia.Sample.App"
             xmlns:local="using:Pysar.Avalonia.Sample"
             RequestedThemeVariant="Dark">
             <!-- The sample wears the dark chrome of the MAUI host, so the theme variant is fixed rather than following the system. -->

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Pysar.Avalonia.Sample/Themes/Colors.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Pysar.Avalonia.Sample/Themes/Styles.axaml" />
    </Application.Styles>
</Application>
