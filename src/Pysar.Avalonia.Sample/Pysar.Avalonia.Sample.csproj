<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
     <ApplicationManifest>app.manifest</ApplicationManifest>
     <ApplicationIcon>Assets/pysar.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <!--
    Font Awesome is not only a report asset: Themes/Colors.axaml addresses it as
    avares://Pysar.Avalonia.Sample/Fonts#Font Awesome 6 Free Solid, and Avalonia's own font manager
    resolves that through its asset loader, never through Pysar's IFileSystem. The embedded copy in
    Pysar.Sample.Shared is therefore invisible to it, and the window fails to open with
    "Could not create glyphTypeface".

    So this one file has to be an Avalonia resource of this assembly - which is exactly what
    ReportAsset becomes in an Avalonia head. The reports' other assets need no declaration here.
  -->
  <ItemGroup>
    <ReportAsset Include="..\Pysar.Sample.Shared\Fonts\Font Awesome 6 Free-Solid-900.otf"
                 Link="Fonts\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <!-- Avalonia 12: Diagnostics moved to AvaloniaUI.DiagnosticsSupport. Exclude from Release output. -->
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Pysar.Xaml" />

    <!--
      Pinned ahead of what Avalonia's Linux support pulls in transitively: 0.21.2 carries a known
      high severity advisory (NU1903, GHSA-xrw6-gwf8-vvr9). It is unused on macOS and Windows, but a
      vulnerable package in the restore graph is noise on every build.
    -->
    <PackageReference Include="Tmds.DBus.Protocol" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pysar.Sample.Shared\Pysar.Sample.Shared.csproj" />
    <PackageReference Include="Pysar.Avalonia" />
  </ItemGroup>
</Project>
