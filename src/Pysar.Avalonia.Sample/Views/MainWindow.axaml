<Window x:Class="Pysar.Avalonia.Sample.Views.MainWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="using:Pysar.Avalonia.Sample.Views"
        xmlns:vm="using:Pysar.Avalonia.Sample.ViewModels"
        Title="Pysar Samples - Avalonia"
        Width="1000"
        Height="700"
        d:DesignHeight="700"
        d:DesignWidth="1000"
        x:DataType="vm:ReportViewerViewModel"
        Background="{StaticResource ChromeSurfaceBrush}"
        Icon="/Assets/pysar.png"
        mc:Ignorable="d">

    <!--
        The desktop window is just a frame now: the whole UI lives in MainView, the UserControl the
        browser and mobile hosts show directly. The DataContext set on the window flows into it.
    -->
    <views:MainView />

</Window>
