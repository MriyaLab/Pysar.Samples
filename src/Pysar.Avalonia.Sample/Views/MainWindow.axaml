<Window x:Class="Pysar.Avalonia.Sample.Views.MainWindow"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:pysar="using:Pysar.Avalonia"
        xmlns:vm="using:Pysar.Avalonia.Sample.ViewModels"
        x:Name="Root"
        Title="Pysar Samples - Avalonia"
        Width="1000"
        Height="700"
        d:DesignHeight="700"
        d:DesignWidth="1000"
        x:DataType="vm:ReportViewerViewModel"
        Background="{StaticResource ChromeSurfaceBrush}"
        Icon="/Assets/pysar.png"
        mc:Ignorable="d">

    <Design.DataContext>
        <vm:ReportViewerViewModel />
    </Design.DataContext>

    <Window.KeyBindings>
        <KeyBinding Command="{Binding PrintCommand}" Gesture="Ctrl+P" />
        <KeyBinding Command="{Binding #Root.ExportPdfCommand}" Gesture="Ctrl+E" />
        <KeyBinding Command="{Binding ZoomInCommand}" Gesture="Ctrl+OemPlus" />
        <KeyBinding Command="{Binding ZoomInCommand}" Gesture="Ctrl+Add" />
        <KeyBinding Command="{Binding ZoomOutCommand}" Gesture="Ctrl+OemMinus" />
        <KeyBinding Command="{Binding ZoomOutCommand}" Gesture="Ctrl+Subtract" />
        <KeyBinding Command="{Binding ActualSizeCommand}" Gesture="Ctrl+D0" />
        <KeyBinding Command="{Binding #Root.ExitCommand}" Gesture="Ctrl+W" />
    </Window.KeyBindings>

    <!--
        The report list is a drawer, as the MAUI Shell flyout is: hidden until the toolbar's
        hamburger opens it, whatever the window size. The window's "nav-open" class carries that
        state; see Themes/Styles.axaml. The panel comes last so it draws above the scrim.
    -->
    <Panel>

        <Grid RowDefinitions="Auto,Auto,Auto,*">

            <Menu Background="{StaticResource ChromeBackgroundBrush}">
                <MenuItem Header="_File">
                    <MenuItem Command="{Binding PrintCommand}"
                              Header="_Print"
                              InputGesture="Ctrl+P" />
                    <MenuItem Command="{Binding #Root.ExportPdfCommand}"
                              Header="_Export PDF..."
                              InputGesture="Ctrl+E" />
                    <Separator />
                    <MenuItem Command="{Binding #Root.ExitCommand}"
                              Header="E_xit"
                              InputGesture="Ctrl+W" />
                </MenuItem>

                <MenuItem Header="_View">
                    <MenuItem Command="{Binding ZoomInCommand}"
                              Header="Zoom _In"
                              InputGesture="Ctrl++" />
                    <MenuItem Command="{Binding ZoomOutCommand}"
                              Header="Zoom _Out"
                              InputGesture="Ctrl+-" />
                    <MenuItem Command="{Binding ActualSizeCommand}"
                              Header="_Actual Size"
                              InputGesture="Ctrl+D0" />
                    <Separator />
                    <MenuItem Command="{Binding FitWidthCommand}"
                              Header="Fit _Width"
                              IsChecked="{Binding IsFitWidth, Mode=OneWay}"
                              ToggleType="Radio" />
                    <MenuItem Command="{Binding FitPageCommand}"
                              Header="Fit _Page"
                              IsChecked="{Binding IsFitPage, Mode=OneWay}"
                              ToggleType="Radio" />
                </MenuItem>
            </Menu>

            <!--  The toolbar is the MAUI report page's: rounded pills on the dark chrome bar.  -->
            <Grid Grid.Row="1"
                  Background="{StaticResource ChromeBackgroundBrush}"
                  ColumnDefinitions="Auto,*">

                <Border Margin="12,8" Classes="toolbar-pill">
                    <Button Classes="toolbar-pill-button icon"
                            Click="OnNavToggleClick"
                            Content="&#xf0c9;"
                            FontSize="14"
                            ToolTip.Tip="Reports" />
                </Border>

                <StackPanel Grid.Column="1"
                            Margin="12,8"
                            HorizontalAlignment="Right"
                            Orientation="Horizontal"
                            Spacing="8">
                    <Border Classes="toolbar-pill">
                        <StackPanel Orientation="Horizontal">
                            <Button Classes="toolbar-pill-button step"
                                    Command="{Binding ZoomOutCommand}"
                                    Content="−"
                                    ToolTip.Tip="Zoom out" />
                            <Border Classes="toolbar-pill-divider" />
                            <Button Classes="toolbar-pill-button wide"
                                    Command="{Binding ActualSizeCommand}"
                                    Content="{Binding ZoomText}"
                                    ToolTip.Tip="Actual size" />
                            <Border Classes="toolbar-pill-divider" />
                            <Button Classes="toolbar-pill-button step"
                                    Command="{Binding ZoomInCommand}"
                                    Content="+"
                                    ToolTip.Tip="Zoom in" />
                        </StackPanel>
                    </Border>

                    <Border Classes="toolbar-pill">
                        <Button Classes="toolbar-pill-button icon"
                                Command="{Binding ToggleFitCommand}"
                                Content="{Binding FitButtonGlyph}"
                                ToolTip.Tip="Fit width or page" />
                    </Border>

                    <Border Classes="toolbar-pill">
                        <Button Classes="toolbar-pill-button icon"
                                Command="{Binding PrintCommand}"
                                Content="&#xf02f;"
                                ToolTip.Tip="Print" />
                    </Border>

                    <Border Classes="toolbar-pill">
                        <Button Classes="toolbar-pill-button icon"
                                Command="{Binding #Root.ExportPdfCommand}"
                                Content="&#xe09a;"
                                ToolTip.Tip="Export PDF" />
                    </Border>
                </StackPanel>
            </Grid>

            <TextBlock Grid.Row="2"
                       Margin="12,0"
                       Foreground="#C0392B"
                       IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                       Text="{Binding ErrorMessage}" />

            <Panel Grid.Row="3">
                <pysar:ReportView x:Name="Viewer"
                                  Background="{StaticResource ChromeViewerBrush}"
                                  CurrentPage="{Binding CurrentPage}"
                                  DocumentPadding="16"
                                  EffectiveZoom="{Binding EffectiveZoom}"
                                  PageBorderColor="{StaticResource ChromePageBorder}"
                                  PageBorderThickness="2"
                                  PageCount="{Binding PageCount, Mode=OneWayToSource}"
                                  PageSpacing="16"
                                  RenderBudget="256"
                                  RenderFailed="OnRenderFailed"
                                  Report="{Binding Report}"
                                  Zoom="{Binding Zoom}"
                                  ZoomMode="{Binding ZoomMode}" />

                <Border x:Name="PageIndicator"
                        Classes="page-indicator"
                        IsVisible="False">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Classes="icon" Text="&#xf15c;" />
                        <TextBlock Text="{Binding PageIndicatorText}" />
                    </StackPanel>
                </Border>
            </Panel>
        </Grid>

        <Border Classes="nav-scrim" PointerPressed="OnNavScrimPressed" />

        <DockPanel Width="250"
                   HorizontalAlignment="Left"
                   Background="{StaticResource ChromeBackgroundBrush}"
                   Classes="nav-panel">
            <Panel Height="200"
                   Margin="0,30,0,40"
                   DockPanel.Dock="Top">
                <Image Margin="10"
                       Opacity="0.1"
                       Source="/Assets/pysar.png"
                       Stretch="Uniform" />
                <TextBlock Margin="20,0"
                           Classes="nav-header-title"
                           Text="Pysar Samples Avalonia"
                           TextWrapping="Wrap" />
            </Panel>

            <ListBox Classes="nav-items"
                     ItemsSource="{Binding Reports}"
                     SelectedItem="{Binding SelectedReport}"
                     SelectionChanged="OnReportSelected">
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:ReportDescriptor">
                        <Grid ColumnDefinitions="40,*">
                            <!--  The selected row trades its report icon for a marker, as the flyout does.  -->
                            <TextBlock Classes="nav-item-icon"
                                       IsVisible="{Binding !$parent[ListBoxItem].IsSelected}"
                                       Text="{Binding Glyph}" />
                            <TextBlock Classes="nav-item-icon marker"
                                       IsVisible="{Binding $parent[ListBoxItem].IsSelected}"
                                       Text="&#xf35a;" />
                            <TextBlock Grid.Column="1"
                                       Classes="nav-item-title"
                                       Text="{Binding Title}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </Panel>

</Window>
