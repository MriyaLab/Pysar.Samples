<Project Sdk="Uno.Sdk/6.8.0-dev.41">
  <PropertyGroup>
    <TargetFrameworks>net10.0-desktop;net10.0-browserwasm;net10.0-android;net10.0-ios</TargetFrameworks>

    <OutputType>Exe</OutputType>
    <UnoSingleProject>true</UnoSingleProject>
    <Nullable>enable</Nullable>

    <!--
      The Uno single project relies on these: the generated code-behind and Platforms/Desktop/Program.cs
      reference Application, Window and STAThread without importing them. The template carries this in
      a solution-level Directory.Build.props, which this repository has its own version of - so it is
      set here instead.
    -->
    <ImplicitUsings>enable</ImplicitUsings>

    <ApplicationTitle>Pysar Uno Sample</ApplicationTitle>
    <ApplicationId>com.mriyalab.pysar.uno.sample</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationPublisher>Mriya Lab</ApplicationPublisher>
    <Description>Pysar report viewer running on Uno Platform.</Description>

    <UnoFeatures>
      SkiaRenderer;
    </UnoFeatures>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pysar.Sample.Shared\Pysar.Sample.Shared.csproj" />
    <PackageReference Include="Pysar.Uno" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

  <!--
    Pysar renders through SkiaSharp 4.151.x while Uno's Skia hosts ask for 3.119; one managed
    SkiaSharp is resolved for the whole application, so these pins make that resolution explicit
    rather than leaving it to whichever request happens to win. The native assets are pinned
    alongside the managed wrapper for the reason Pysar's own Directory.Packages.props documents: a
    split between the two is a startup crash, not a build error.
  -->
  <ItemGroup>
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.NativeAssets.macOS" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" />
    <PackageReference Include="HarfBuzzSharp" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-android'">
    <PackageReference Include="SkiaSharp.NativeAssets.Android" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.Android" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0-ios'">
    <PackageReference Include="SkiaSharp.NativeAssets.iOS" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.iOS" />
  </ItemGroup>

  <!--
    Chrome fonts for the WinUI shell (sidebar title + toolbar glyphs). Separate from the
    report EmbeddedResource fonts: those are read synchronously by Pysar, these are
    loaded by the XAML font stack.
  -->
  <ItemGroup>
    <UnoFont Include="Assets\Fonts\Cookie-Regular.ttf" />
    <UnoFont Include="Assets\Fonts\Font Awesome 6 Free-Solid-900.otf" />
  </ItemGroup>

  <!--
    The shared report assets are not declared here: Pysar.Sample.Shared declares them once as
    ReportAsset, which embeds them into its own assembly under the paths the reports ask for, and
    UnoReportPlatformHandler falls back to the embedded assets of referenced libraries after this
    application's own.

    The fallback keeps the property this head depends on - reads stay synchronous. Font registration
    and image loading never await, Uno's ms-appx:/// path is asynchronous, and on the WebAssembly
    host blocking on it deadlocks the single thread rather than stalling it. A manifest resource has
    no such problem, whichever assembly it is embedded in.

    The shared Styles/ travel the same way, and must: the reports pull brushes and styles in through
    <ResourceDictionary Source="..."/>, whose Source resolves against the directory the project was
    compiled in - a path that exists only on the build machine. The desktop host gets away with that
    because the two are the same machine; a browser has no file system at all.
  -->

</Project>
