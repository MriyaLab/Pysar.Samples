<Project Sdk="Uno.Sdk/6.8.0-dev.41">
  <PropertyGroup>
    <TargetFrameworks>net10.0-desktop;net10.0-browserwasm</TargetFrameworks>

    <OutputType>Exe</OutputType>
    <UnoSingleProject>true</UnoSingleProject>
    <Nullable>enable</Nullable>

    <!--
      The Uno single project relies on these: the generated code-behind and Platforms/Desktop/Program.cs
      reference Application, Window and STAThread without importing them. The template carries this in
      a solution-level Directory.Build.props, which this repository has its own version of - so it is
      set here instead.
    -->
    <ImplicitUsings>enable</ImplicitUsings>

    <ApplicationTitle>Pysar Uno Sample</ApplicationTitle>
    <ApplicationId>com.mriyalab.pysar.uno.sample</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationPublisher>Mriya Lab</ApplicationPublisher>
    <Description>Pysar report viewer running on Uno Platform.</Description>

    <UnoFeatures>
      SkiaRenderer;
    </UnoFeatures>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pysar.Sample.Shared\Pysar.Sample.Shared.csproj" />
    <PackageReference Include="Pysar.Uno" />
  </ItemGroup>

  <!--
    Pysar renders through SkiaSharp 4.151.x while Uno's Skia hosts ask for 3.119; one managed
    SkiaSharp is resolved for the whole application, so these pins make that resolution explicit
    rather than leaving it to whichever request happens to win. The native assets are pinned
    alongside the managed wrapper for the reason Pysar's own Directory.Packages.props documents: a
    split between the two is a startup crash, not a build error.
  -->
  <ItemGroup>
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.NativeAssets.macOS" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" />
    <PackageReference Include="HarfBuzzSharp" />
  </ItemGroup>

  <!--
    Chrome fonts for the WinUI shell (sidebar title + toolbar glyphs). Separate from the
    report EmbeddedResource fonts: those are read synchronously by Pysar, these are
    loaded by the XAML font stack.
  -->
  <ItemGroup>
    <UnoFont Include="Assets\Fonts\Cookie-Regular.ttf" />
    <UnoFont Include="..\Pysar.Sample.Shared\Fonts\Font Awesome 6 Free-Solid-900.otf">
      <Link>Assets\Fonts\Font Awesome 6 Free-Solid-900.otf</Link>
    </UnoFont>
  </ItemGroup>

  <!--
    The report assets live beside the reports that use them in Pysar.Sample.Shared and are shared
    with the other samples, so they are linked here rather than copied. EmbeddedResource with an
    explicit LogicalName is what UnoAssetFileSystem resolves against, and the LogicalName has to be
    the exact relative path the reports ask for - "Fonts/...", "Images/...".

    Embedded rather than Content because asset reads have to be synchronous: font registration and
    image loading never await, Uno's ms-appx:/// path is asynchronous, and on the WebAssembly host
    blocking on it deadlocks the single thread rather than stalling it.
  -->
  <ItemGroup>
    <EmbeddedResource Include="..\Pysar.Sample.Shared\Fonts\**"
                      LogicalName="Fonts/%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\Pysar.Sample.Shared\Images\**"
                      LogicalName="Images/%(Filename)%(Extension)" />
    <!--
      The reports pull shared brushes and styles in through <ResourceDictionary Source="..."/>, and
      that Source is resolved against the directory the project was compiled in - a path that only
      exists on the build machine. The desktop host gets away with it because the two are the same
      machine; a browser has no file system at all, so the styles have to travel as assets the
      platform handler can serve, exactly like the fonts and images above.
    -->
    <EmbeddedResource Include="..\Pysar.Sample.Shared\Styles\**"
                      LogicalName="Styles/%(Filename)%(Extension)" />
    <EmbeddedResource Update="..\Pysar.Sample.Shared\Fonts\Font Awesome 6 Free-Regular-400.otf">
      <Link>Fonts\Font Awesome 6 Free-Regular-400.otf</Link>
    </EmbeddedResource>
    <EmbeddedResource Update="..\Pysar.Sample.Shared\Fonts\Font Awesome 6 Free-Solid-900.otf">
      <Link>Fonts\Font Awesome 6 Free-Solid-900.otf</Link>
    </EmbeddedResource>
    <EmbeddedResource Update="..\Pysar.Sample.Shared\Fonts\LibreBarcode128-Regular.ttf">
      <Link>Fonts\LibreBarcode128-Regular.ttf</Link>
    </EmbeddedResource>
    <EmbeddedResource Update="..\Pysar.Sample.Shared\Fonts\Ubuntu-Bold.ttf">
      <Link>Fonts\Ubuntu-Bold.ttf</Link>
    </EmbeddedResource>
    <EmbeddedResource Update="..\Pysar.Sample.Shared\Fonts\Ubuntu-Italic.ttf">
      <Link>Fonts\Ubuntu-Italic.ttf</Link>
    </EmbeddedResource>
    <EmbeddedResource Update="..\Pysar.Sample.Shared\Fonts\Ubuntu-Regular.ttf">
      <Link>Fonts\Ubuntu-Regular.ttf</Link>
    </EmbeddedResource>
    <EmbeddedResource Update="..\Pysar.Sample.Shared\Images\logo.svg">
      <Link>Images\logo.svg</Link>
    </EmbeddedResource>
    <EmbeddedResource Update="..\Pysar.Sample.Shared\Images\student.png">
      <Link>Images\student.png</Link>
    </EmbeddedResource>
  </ItemGroup>

</Project>
