@page "/"
@page "/report/{Slug}"
@using Pysar.Blazor
@using Pysar.Blazor.Wasm.Sample.Services
@using Pysar.Elements
@using Pysar.Export
@using Pysar.Sample.Shared
@using Pysar.Skia
@using Pysar.Viewer.Zoom
@implements IDisposable
@inject HttpClient Http
@inject IReportPrinter Printer
@inject IReportExportService Exporter
@inject IJSRuntime JS
@inject NavigationManager Navigation

<PageTitle>@_descriptor.Title - Pysar Samples</PageTitle>

@*
    The toolbar mirrors the MAUI report page: rounded pills on the dark chrome bar, with the
    zoom controls grouped into a single pill. The drawer toggle is the MAUI hamburger and,
    like there, only earns its place when the panel is not permanently on screen.
*@
<div class="toolbar">
    <button class="toolbar-pill toolbar-pill-button nav-toggle"
            title="Reports"
            @onclick="() => Layout?.ToggleNav()">
        <span class="fa" aria-hidden="true">@("\uf0c9")</span>
    </button>

    <div class="toolbar-spacer"></div>

    <div class="toolbar-pill">
        <button class="toolbar-pill-button step" title="Zoom out" @onclick="ZoomOut">&minus;</button>
        <span class="toolbar-pill-divider"></span>
        <button class="toolbar-pill-button wide" title="Actual size" @onclick="ActualSize">@ZoomText</button>
        <span class="toolbar-pill-divider"></span>
        <button class="toolbar-pill-button step" title="Zoom in" @onclick="ZoomIn">+</button>
    </div>

    <div class="toolbar-pill">
        <button class="toolbar-pill-button" title="@FitButtonTitle" @onclick="ToggleFit">
            <span class="fa" aria-hidden="true">@FitButtonGlyph</span>
        </button>
    </div>

    <div class="toolbar-pill">
        <button class="toolbar-pill-button"
                title="Print"
                disabled="@(_isBusy || _report is null)"
                @onclick="PrintAsync">
            <span class="fa" aria-hidden="true">@("\uf02f")</span>
        </button>
    </div>

    <div class="toolbar-pill">
        <button class="toolbar-pill-button"
                title="Export PDF"
                disabled="@(_isBusy || _report is null)"
                @onclick="ExportPdfAsync">
            <span class="fa" aria-hidden="true">@("\ue09a")</span>
        </button>
    </div>
</div>

@if (!string.IsNullOrEmpty(_error))
{
    <pre class="viewer-error">@_error</pre>
}

<div class="viewer-host">
    @if (_report is not null)
    {
        <ReportView Report="_report"
                    CurrentPage="_currentPage"
                    CurrentPageChanged="OnCurrentPageChanged"
                    DocumentPadding="16"
                    EffectiveZoomChanged="zoom => _effectiveZoom = zoom"
                    PageBorderColor="#3E4351"
                    PageBorderThickness="2"
                    PageCountChanged="OnPageCountChanged"
                    PageSpacing="16"
                    RenderBudget="256"
                    RenderFailed="exception => _error = exception.ToString()"
                    Zoom="_zoom"
                    ZoomChanged="zoom => _zoom = zoom"
                    ZoomMode="_zoomMode"
                    ZoomModeChanged="mode => _zoomMode = mode" />
    }

    @if (_isPageIndicatorVisible)
    {
        <div class="page-indicator">
            <span class="fa" aria-hidden="true">@("\uf15c")</span>
            <span>@PageIndicatorText</span>
        </div>
    }
</div>

@code {
    /// <summary>The zoom levels the minus and plus buttons step through, as a browser does.</summary>
    private static readonly double[] ZoomSteps =
        [0.25, 0.33, 0.5, 0.67, 0.75, 0.8, 0.9, 1, 1.1, 1.25, 1.5, 1.75, 2, 2.5, 3, 4, 5];

    // Not "Assets": ComponentBase has a property of that name, and hiding it is a warning.
    private static readonly string[] ReportAssets =
    [
        "Fonts/Ubuntu-Regular.ttf",
        "Fonts/Ubuntu-Bold.ttf",
        "Fonts/Ubuntu-Italic.ttf",
        "Fonts/Font Awesome 6 Free-Solid-900.otf",
        "Fonts/Font Awesome 6 Free-Regular-400.otf",
        "Fonts/LibreBarcode128-Regular.ttf",
        "Images/logo.svg",
        "Images/student.png",
        "Styles/ReportStyles.rxaml",
        "Styles/ReportColors.rxaml"
    ];

    private ReportDescriptor _descriptor = ReportDescriptor.All[0];
    private Report? _report;
    private string? _error;
    private bool _isBusy;
    private bool _assetsLoaded;

    private ReportZoomMode _zoomMode = ReportZoomMode.FitWidth;

    /// <summary>The zoom asked for; meaningful only while the mode is Custom.</summary>
    private double _zoom = 1;

    /// <summary>
    ///     The zoom the viewer actually settled on, reported back by the control. A fit mode resolves
    ///     to a factor only the control knows, so the percentage has to come from there.
    /// </summary>
    private double _effectiveZoom = 1;

    private int _currentPage = 1;
    private int _pageCount;

    private bool _isPageIndicatorVisible;
    private CancellationTokenSource? _pageIndicatorHideCts;

    /// <summary>The report to show; absent on the root route, which falls back to the first report.</summary>
    [Parameter]
    public string? Slug { get; set; }

    [CascadingParameter]
    public MainLayout? Layout { get; set; }

    private string ZoomText => $"{Math.Round(_effectiveZoom * 100)}%";

    private string FitButtonGlyph => _zoomMode == ReportZoomMode.FitWidth ? "\uf065" : "\uf337";

    private string FitButtonTitle => _zoomMode == ReportZoomMode.FitWidth ? "Fit page" : "Fit width";

    /// <summary>Transient overlay label shown while the current page changes.</summary>
    private string PageIndicatorText => $"{_currentPage} of {_pageCount}";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            WasmPlatformHandler.Install(await PreloadedFileSystem.FetchAsync(Http, ReportAssets));

            // Not ReportBootstrap.Initialize: that installs a disk-reading file system. These two
            // registrations are host-agnostic by design and are what the MAUI host calls too.
            ReportBootstrap.RegisterFonts(
                Pysar.Core.ReportPlatformHandler.FontCollection);

            _assetsLoaded = true;
        }
        catch (Exception exception)
        {
            _error = exception.ToString();

            return;
        }

        LoadReport();
    }

    protected override void OnParametersSet()
    {
        // The root route carries no report; land on the first one so the panel can mark it selected.
        if (Slug is null)
        {
            Navigation.NavigateTo($"report/{ReportDescriptor.All[0].Slug}", replace: true);

            return;
        }

        var descriptor = ReportDescriptor.Find(Slug);
        if (ReferenceEquals(descriptor, _descriptor) && _report is not null)
            return;

        _descriptor = descriptor;

        if (_assetsLoaded)
            LoadReport();
    }

    public void Dispose() => CancelPageIndicatorHide();

    private void LoadReport()
    {
        try
        {
            var report = _descriptor.Create();
            report.Build();

            _report = report;
            _currentPage = 1;
            _error = null;
        }
        catch (Exception exception)
        {
            _report = null;
            _error = exception.ToString();
        }
    }

    private void OnCurrentPageChanged(int page)
    {
        _currentPage = page;

        ShowPageIndicator();
    }

    private void OnPageCountChanged(int count)
    {
        _pageCount = count;

        ShowPageIndicator();
    }

    /// <summary>Reveals the page overlay and hides it again after a few idle seconds, as MAUI does.</summary>
    private void ShowPageIndicator()
    {
        if (_pageCount < 1)
            return;

        _isPageIndicatorVisible = true;
        CancelPageIndicatorHide();

        var cts = new CancellationTokenSource();
        _pageIndicatorHideCts = cts;

        _ = HidePageIndicatorAsync(cts.Token);
    }

    private async Task HidePageIndicatorAsync(CancellationToken token)
    {
        try
        {
            await Task.Delay(TimeSpan.FromSeconds(3), token);

            _isPageIndicatorVisible = false;

            StateHasChanged();
        }
        catch (OperationCanceledException)
        {
        }
    }

    private void CancelPageIndicatorHide()
    {
        _pageIndicatorHideCts?.Cancel();
        _pageIndicatorHideCts?.Dispose();
        _pageIndicatorHideCts = null;
    }

    private void ToggleFit()
        => _zoomMode = _zoomMode == ReportZoomMode.FitWidth ? ReportZoomMode.FitPage : ReportZoomMode.FitWidth;

    private void ZoomIn()
    {
        var next = ZoomSteps.FirstOrDefault(step => step > _effectiveZoom + 0.001);
        if (next > 0)
            SetZoom(next);
    }

    private void ZoomOut()
    {
        var previous = ZoomSteps.LastOrDefault(step => step < _effectiveZoom - 0.001);
        if (previous > 0)
            SetZoom(previous);
    }

    private void ActualSize() => SetZoom(1);

    private void SetZoom(double zoom)
    {
        _zoom = zoom;
        _zoomMode = ReportZoomMode.Custom;
    }

    private async Task PrintAsync()
    {
        if (_report is null || _isBusy)
            return;

        _isBusy = true;
        _error = null;

        try
        {
            await Printer.PrintAsync(_report);
        }
        catch (Exception exception)
        {
            _error = exception.ToString();
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task ExportPdfAsync()
    {
        if (_report is null || _isBusy)
            return;

        _isBusy = true;
        _error = null;

        try
        {
            var bytes = await Exporter.ExportAsync(_report, ExportFormat.Pdf);

            await JS.InvokeVoidAsync(
                "pysarSample.downloadFile",
                _descriptor.FileName,
                "application/pdf",
                Convert.ToBase64String(bytes));
        }
        catch (Exception exception)
        {
            _error = exception.ToString();
        }
        finally
        {
            _isBusy = false;
        }
    }
}
