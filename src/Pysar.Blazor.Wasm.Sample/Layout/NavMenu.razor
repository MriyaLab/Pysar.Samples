@using Pysar.Blazor.Wasm.Sample.Services

<div class="nav-header">
    <img class="nav-header-mark" src="Images/pysar.svg" alt="" />
    <span class="nav-header-title">Pysar Samples Blazor</span>
</div>

<nav class="nav-items">
    @foreach (var descriptor in ReportDescriptor.All)
    {
        <NavLink class="nav-item" href="@($"report/{descriptor.Slug}")" @onclick="OnNavigated">
            <span class="fa nav-item-icon" aria-hidden="true">@descriptor.Glyph</span>
            <span class="nav-item-title">@descriptor.Title</span>
        </NavLink>
    }
</nav>

@code {
    /// <summary>Raised after a report is picked so a narrow-window drawer can close itself.</summary>
    [Parameter]
    public EventCallback OnNavigated { get; set; }
}
