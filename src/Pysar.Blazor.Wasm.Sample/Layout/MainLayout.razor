@inherits LayoutComponentBase

@*
    The MAUI sample opens its report list as a Shell flyout; here the same list is a
    permanent side panel, collapsing into a drawer only when the window is too narrow.
    The layout is cascaded so a page's toolbar can own the drawer toggle, as it does in MAUI.
*@
<CascadingValue Value="this" IsFixed="true">
    <div class="page @(IsNavOpen ? "nav-open" : null)">
        <div class="sidebar">
            <NavMenu OnNavigated="CloseNav" />
        </div>

        <div class="nav-scrim" @onclick="CloseNav"></div>

        <main>
            @Body
        </main>
    </div>
</CascadingValue>

@code {
    /// <summary>Whether the drawer is showing; it only has an effect on narrow windows.</summary>
    public bool IsNavOpen { get; private set; }

    public void ToggleNav()
    {
        IsNavOpen = !IsNavOpen;

        StateHasChanged();
    }

    private void CloseNav()
    {
        if (!IsNavOpen)
            return;

        IsNavOpen = false;

        StateHasChanged();
    }
}
