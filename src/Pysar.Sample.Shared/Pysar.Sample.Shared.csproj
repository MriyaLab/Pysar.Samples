<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <!--
          The design-time preview host is published into this project's output directory and loads
          the reports from there. A library does not copy its NuGet dependencies to bin by default,
          so SkiaSharp and friends would be missing at that point.
        -->
        <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Pysar" />
      <PackageReference Include="Pysar.Xaml" />
      <PackageReference Include="SkiaSharp.QrCode" />
    </ItemGroup>

    <!--
      One declaration for every head. Pysar.Assets.targets embeds these into this assembly, and each
      host's file system falls back to it - no per-head re-declaration, and nothing to keep in sync.-->
    
    <ItemGroup>
      <ReportAsset Include="Fonts\**;Images\**;Styles\**" />
    </ItemGroup>
    
</Project>
